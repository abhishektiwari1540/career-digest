# ==============================================================================
# AI CAREER DIGEST & SECOND BRAIN - COMPLETE ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env` and fill in your API credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Vector Storage & Second Brain Memory)
# Get keys from: https://app.supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ------------------------------------------------------------------------------
# 2. PRIMARY LLM - GOOGLE GEMINI (AI Studio)
# Free tier key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 3. LLM FALLBACK 1 - GROQ (Fast Free LLM)
# Free key: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. LLM FALLBACK 2 - OPENROUTER (Multi-Model Free Access)
# Free key: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# ------------------------------------------------------------------------------
# 5. JOB LISTINGS - ADZUNA API
# Free developer portal: https://developer.adzuna.com/
# ------------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_WHAT=software developer
ADZUNA_WHERE=jaipur

# ------------------------------------------------------------------------------
# 6. WEB SEARCH & YOUTUBE DATA API
# Google Cloud Console: https://console.cloud.google.com/
# ------------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY - RESEND
# Free tier: https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=
DIGEST_TO_EMAIL=abhishekabhit57@gmail.com
DIGEST_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 8. PROFILE & DEVELOPER BRAND HANDLES
# ------------------------------------------------------------------------------
CANDIDATE_NAME=Abhishek Tiwari
CANDIDATE_LOCATION=Jaipur, Rajasthan, India
PROFILE_SKILLS=typescript,node,react,postgres,rest-apis
GITHUB_USERNAME=
LEETCODE_USERNAME=
STACKOVERFLOW_USER_ID=

# ------------------------------------------------------------------------------
# 9. SOCIAL MEDIA AUTO-PUBLISHERS
# ------------------------------------------------------------------------------
# Dev.to (Settings -> Extensions -> API Keys): https://dev.to/settings/extensions
DEVTO_API_KEY=

# LinkedIn OAuth App: https://www.linkedin.com/developers/apps
# Use http://localhost:3005/api/linkedin/login to auto-generate access token & URN
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Bluesky (Settings -> App Passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon (Preferences -> Development -> New Application)
MASTODON_SERVER_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Meta Graph API (Instagram / Facebook / Threads)
META_ACCESS_TOKEN=
META_PAGE_ID=

# ------------------------------------------------------------------------------
# 10. APP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3005
DAEMON_MODE=false
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
